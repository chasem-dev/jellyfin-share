# Copy to .env and edit for your host. Do not publish .env.
PORTAL_IMAGE=ghcr.io/chasem-dev/jellyfin-share:0.1.0
PUID=1000
PGID=1000

# The full URL shown in generated links. Use your HTTPS domain for internet sharing.
PUBLIC_URL=http://127.0.0.1:8787
PUBLIC_HOST_BIND=127.0.0.1
PUBLIC_HOST_PORT=8787

# Keep the manager on localhost, or set this to your server's LAN IP.
# If using a LAN IP, add that IP to MANAGER_ALLOWED_HOSTS.
MANAGER_HOST_BIND=127.0.0.1
MANAGER_HOST_PORT=8788
MANAGER_ALLOWED_HOSTS=127.0.0.1,localhost

# Existing directories containing your media. The container reads them only.
MOVIES_DIR=./library/Movies
TV_DIR=./library/TV

# Persistent link database and playback cache. Both must be writable by PUID:PGID.
DATA_DIR=./instance/data
CACHE_DIR=./instance/cache

# Only for the optional Caddy HTTPS setup in compose.proxy.yml.
SHARE_DOMAIN=share.example.com

# Optional Jellyfin poster mount for compose.posters.yml.
# JELLYFIN_METADATA_DIR=/path/to/jellyfin/metadata/library
